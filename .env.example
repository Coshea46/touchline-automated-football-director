# Copy to .env in the repository root. .env is ignored and backend-only.
# Keep real values out of frontend REACT_APP_* variables and version control.
FOOTBALL_DATA_API_KEY=
GUARDIAN_API_KEY=
ELEVENLABS_API_KEY=

# Live captions are paid, focused-match-only Scribe v2 Realtime.
# A configured key starts captions automatically when focused playback begins.
# The viewer's Off control stops audio; no special activation flag is required.
# Optional service-wide override: set MATCHPULSE_CAPTIONS_ENABLED=false to disable.
MATCHPULSE_CAPTIONS_ENABLED=true
# Existing session safeguards apply across switches, pauses, reconnects and toggles.
MATCHPULSE_CAPTION_MAX_AUDIO_SECONDS=28800
MATCHPULSE_CAPTION_BUDGET_USD=3.60
# Local setup: isolated venv, separate from inference dependencies.
# Windows: backend/.venv-captions/Scripts/python.exe
# Linux/macOS: backend/.venv-captions/bin/python
# Docker sets its own /opt/matchpulse-captions/bin/python.
MATCHPULSE_CAPTION_PYTHON=backend/.venv-captions/Scripts/python.exe

# Optional root for .env and backend/artifacts in an installed/hosted package.
# Editable installs discover the monorepo; Docker sets this to /app.
# MATCHPULSE_PROJECT_ROOT=/absolute/path/to/application

# The persistent local website uses: python -m touchline.local
# Auto On can start the prepared real model using existing private WS credentials.
# No GPU runs until that explicit request; --allow-cloud starts on playback instead.
# Both default to a 40-minute/$10 estimated service allowance, with no renewed deadline.
# Local --seconds supports 30-3600; --budget supports $0.01-$20.
# Use --offline to disable starting cloud inference; --no-captions also disables STT.
# HTTP/WebSocket remain available when inference expires; no paid auto-renewal.
MATCHPULSE_MONITOR=false
# Once monitoring is explicitly enabled, blank mode/checkpoint/version select
# the pinned research-winning temporal shots3_10 release automatically.
# The finite touchline.demo command is a test harness and closes the whole service.
# Explicit rollback: add --model legacy. No model-specific environment variables needed.
MATCHPULSE_API_ENABLED=true
MATCHPULSE_API_PORT=8031
# Set these only for a different frontend origin.
MATCHPULSE_API_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3030,http://127.0.0.1:3030
